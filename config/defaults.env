# Defaults for local builds.
#
# Precedence (highest first):
#   1. environment variable
#   2. this file
#   3. hard-coded fallback in scripts/render.py
#
# In GitHub Actions the workflow exports the same names from
# secrets/variables, so a repository secret overrides these defaults.
#
# WARNING: WIN_PASSWORD is embedded in the built image in clear text.
# The default below is intentionally weak and is only suitable for a
# throwaway lab VM that is not reachable from the internet.

WIN_USERNAME=User
WIN_PASSWORD=oci-a1
COMPUTER_NAME=OCI-WIN
TIMEZONE=Tokyo Standard Time
