+static void test_read_shapes (FS *fs) {
+  static const struct { CHAR16 *path; const char *name; } t[] = {
+    { L"\\Windows\\System32\\ntoskrnl.exe", "ntoskrnl" },
+    { L"\\Windows\\System32\\winload.efi",  "winload" },
+    { L"\\Windows\\System32\\config\\SYSTEM", "SYSTEM" },
+  };
+  UINT8  raw[8192 + 512];
+  UINT8 *stk16  = raw + 0x40;   /* 16B aligned, not 512B */
+  UINT8 *stk512 = (UINT8 *)(((UINTN)raw + 511) & ~(UINTN)511);
+  int    k;
+
+  for (k = 0; k < (int)(sizeof (t) / sizeof (t[0])); k++) {
+    EFI_FILE_HANDLE f = NULL;
+    EFI_FILE_INFO  *fi;
+    UINT64          fsize = 0;
+    UINTN           sz = 1024;
+    EFI_STATUS      st;
+
+    st = fs->root->Open (fs->root, &f, t[k].path, EFI_FILE_MODE_READ, 0);
+    say ("--- SHAPE "); say (t[k].name); say (" ---"); nl ();
+    say ("  open -> "); say_st ("st", st); nl ();
+    if (EFI_ERROR (st)) { g_shape_fail++; continue; }
+    fi = (EFI_FILE_INFO *)g_buf;
+    if (!EFI_ERROR (f->GetInfo (f, &gEfiFileInfoGuid, &sz, fi))) {
+      fsize = fi->FileSize;
+      say ("  size="); say_dec (fsize); nl ();
+    }
+    shape_read (f, "stk16-1k",   0, 1024, stk16);
+    shape_read (f, "stk512-1k",  0, 1024, stk512);
+    shape_read (f, "pool-1k",    0, 1024, g_buf);
+    shape_read (f, "pool+1-1k",  0, 1024, g_buf + 1);
+    shape_read (f, "stk16-512",  0, 512,  stk16);
+    shape_read (f, "stk16-2k",   0, 2048, stk16);
+    shape_read (f, "stk16-4k",   0, 4096, stk16);
+    shape_read (f, "stk16-8k",   0, 8192, stk16);
+    shape_read (f, "stk16-1k@4k",   0x1000, 1024, stk16);
+    shape_read (f, "stk16-1k@64k",  0x10000, 1024, stk16);
+    if (fsize > 0x2000)
+      shape_read (f, "stk16-1k@tail", fsize - 0x800, 1024, stk16);
+    f->Close (f);
+  }
+  say ("### SHAPE fail="); say_dec (g_shape_fail); nl ();
+}
