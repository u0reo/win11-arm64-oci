+/* ---- 大サイズ単一 Read テスト (winload ImgpLoadPEImage 再現) ---------- */
+static void big_read_one (FS *fs, CHAR16 *path, const char *name,
+                          UINTN bufsz, UINT64 off) {
+  EFI_FILE_HANDLE f = NULL;
