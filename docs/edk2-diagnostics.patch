+  say (" got="); say_dec (got);
+  if (!EFI_ERROR (st) && got) {
+    say (" fnv="); hex64 (fnv (FNV_INIT, buf, got));
+    say (" head="); print_head (buf, got);
+  }
+  nl ();
+  g_bs->FreePool (buf);
+  f->Close (f);
+}
+
+static void big_read_seq (FS *fs, CHAR16 *path, const char *name,
+                          UINTN bufsz) {
+  EFI_FILE_HANDLE f = NULL;
+  EFI_FILE_INFO  *fi;
+  EFI_STATUS      st;
+  UINT8          *buf = NULL;
+  UINTN           got, want, sz;
+  UINT64          fsize = 0, total = 0, h = FNV_INIT;
+
+  st = fs->root->Open (fs->root, &f, path, EFI_FILE_MODE_READ, 0);
+  say ("  SEQ "); say (name); say (" chunk="); say_dec (bufsz);
+  say (" open="); say_st ("st", st);
+  if (EFI_ERROR (st)) { nl (); return; }
+  fi = (EFI_FILE_INFO *)g_buf;
+  sz = 1024;
+  if (!EFI_ERROR (f->GetInfo (f, &gEfiFileInfoGuid, &sz, fi))) fsize = fi->FileSize;
+  st = g_bs->AllocatePool (EfiLoaderData, bufsz, (VOID **)&buf);
+  if (EFI_ERROR (st) || buf == NULL) {
+    say (" pool="); say_st ("st", st); nl ();
+    f->Close (f);
+    return;
+  }
+  st = f->SetPosition (f, 0);
+  while (!EFI_ERROR (st) && total < fsize) {
+    want = (fsize - total > bufsz) ? bufsz : (UINTN)(fsize - total);
+    got = want;
+    st = f->Read (f, &got, buf);
+    if (EFI_ERROR (st) || got != want) {
+      say (" FAIL at "); hexval (total, 8);
+      say (" want="); say_dec (want);
+      say (" got="); say_dec (got);
+      say (" st="); say_st ("st", st);
+      break;
+    }
+    h = fnv (h, buf, got);
+    total += got;
+  }
+  say (" total="); say_dec (total);
+  say (" fnv="); hex64 (h);
+  say (" st="); say_st ("st", st);
+  nl ();
+  g_bs->FreePool (buf);
+  f->Close (f);
+}
+
+static void test_big_reads (FS *fs) {
+  UINTN nsz = 11486624, wsz = 3156408;
+
+  say ("--- BIGREAD BEGIN ---"); nl ();
+  big_read_one (fs, L"\\Windows\\System32\\ntoskrnl.exe", "ntos-full", nsz, 0);
+  big_read_one (fs, L"\\Windows\\System32\\ntoskrnl.exe", "ntos-1M", 1024*1024, 0);
+  big_read_one (fs, L"\\Windows\\System32\\ntoskrnl.exe", "ntos-2M", 2*1024*1024, 0);
+  big_read_one (fs, L"\\Windows\\System32\\ntoskrnl.exe", "ntos-4M", 4*1024*1024, 0);
+  big_read_one (fs, L"\\Windows\\System32\\ntoskrnl.exe", "ntos-8M", 8*1024*1024, 0);
+  big_read_one (fs, L"\\Windows\\System32\\winload.efi", "wl-full", wsz, 0);
+  big_read_one (fs, L"\\Windows\\System32\\winload.efi", "wl-1M", 1024*1024, 0);
+  big_read_one (fs, L"\\Windows\\System32\\winload.efi", "wl-2M", 2*1024*1024, 0);
+  big_read_one (fs, L"\\Windows\\System32\\apisetschema.dll", "schema", 183208, 0);
+  big_read_seq (fs, L"\\Windows\\System32\\ntoskrnl.exe", "ntos-1M", 1024*1024);
+  big_read_seq (fs, L"\\Windows\\System32\\ntoskrnl.exe", "ntos-64K", 65536);
+  say ("--- BIGREAD END ---"); nl ();
+}
+
+EFI_STATUS EFIAPI RdChkMain (EFI_HANDLE ImageHandle,
+                            EFI_SYSTEM_TABLE *SystemTable) {
+  EFI_STATUS  st;
+  EFI_HANDLE *hs = NULL;
+  UINTN       n = 0;
+  FS         *fesp, *fwin;
+
+  g_image  = ImageHandle;
+  g_st     = SystemTable;
+  g_bs     = g_st->BootServices;
+  g_conout = g_st->ConOut;
+  say ("[S1]");
+
+  /* シリアルテキストアウト（あれば） */
+  if (!EFI_ERROR (g_bs->LocateHandleBuffer (ByProtocol,
+          &gEfiSerialIoProtocolGuid, NULL, &n, &hs)) && n) {
+    g_bs->HandleProtocol (hs[0], &gEfiSimpleTextOutProtocolGuid,
+                          (VOID **)&g_serout);
+    g_bs->FreePool (hs);
+  }
+  say ("[S2]");
+
+  say ("### ");
+  say (TAG);
+  say (" BEGIN\n");
+  open_logs ();
+  say ("[S3]");
+  g_buf = NULL;
+  st = g_bs->AllocatePool (EfiLoaderData, BIGBUF, (VOID **)&g_buf);
+  say ("[pool ");
+  say_st ("st", st);
+  say (" size=4MB ptr=");
+  hexval ((UINT64)(UINTN)g_buf, 16);
+  say ("]\n");
+  if (EFI_ERROR (st) || !g_buf) { close_logs (); return st; }
+
+  enum_fs ();
+  fesp = find_fs (1);
+  fwin = find_fs (0);
+  say ("[fs] esp=");
+  hexval ((UINT64)(UINTN)fesp, 8);
+  say (" win=");
+  hexval ((UINT64)(UINTN)fwin, 8);
+  nl ();
+
+  if (fesp) {
+    test_file (fesp, "rdchk.efi",  L"\\rdchk.efi", 0);
+    test_file (fesp, "ntfs_aa64",  L"\\EFI\\NTFS\\ntfs_aa64.efi", 188416);
+    probe_load (fesp, "rdchk.efi",  L"\\rdchk.efi");
+    probe_load (fesp, "bootmgfw",   L"\\EFI\\Microsoft\\Boot\\bootmgfw.efi");
+    test_file (fesp, "bootmgfw", L"\\EFI\\Microsoft\\Boot\\bootmgfw.efi", 2622784);
+    test_file (fesp, "BCD",      L"\\EFI\\Microsoft\\Boot\\BCD", 0);
+    test_dir  (fesp, "bootdir",  L"\\EFI\\Microsoft\\Boot");
+    test_dir  (fesp, "root",     L"\\");
+  }
+  if (fwin) {
+    new_test (fwin);
+    test_read_shapes (fwin);
+    test_big_reads (fwin);
+    test_file (fwin, "V5A.TXT", L"\\V5A.TXT", 40);
+    test_file (fwin, "rdchk.efi", L"\\rdchk.efi", 0);
+    test_file (fwin, "hal.dll", L"\\Windows\\System32\\hal.dll", 17216);
+    test_file (fwin, "winload.efi", L"\\Windows\\System32\\winload.efi",
+               2947320);
+    probe_load (fwin, "rdchk.efi", L"\\rdchk.efi");
+    probe_load (fwin, "hal.dll",   L"\\Windows\\System32\\hal.dll");
+    probe_load (fwin, "winload",   L"\\Windows\\System32\\winload.efi");
+    test_file (fwin, "SYSTEM-hive", L"\\Windows\\System32\\config\\SYSTEM", 0);
+    test_dir  (fwin, "root",  L"\\");
+    test_dir  (fwin, "sys32", L"\\Windows\\System32");
+  }
+
+  say ("### ");
+  say (TAG);
+  say (" NTFS-read-fail=");
+  say_dec (g_ntfs_reads_fail);
+  say (" NTFS-bytes=");
+  say_dec (g_ntfs_bytes_read);
+  say (" seek-rej="); say_dec (g_ntfs_seek_rej);
+  say (" eofshort="); say_dec (g_ntfs_eofshort);
+  nl ();
+  say (" new-fail="); say_dec (g_ntfs_new_fail);
+  say (" miss="); say_dec (g_ntfs_miss);
+  if (!fwin) say ("### VERDICT NTFS-FS-NOT-FOUND\n");
+  else if (g_ntfs_reads_fail) say ("### VERDICT NTFS-READ-BROKEN\n");
+  else say ("### VERDICT NTFS-READ-ALL-OK\n");
+  say ("### ");
+  say (TAG);
+  say (" END\n");
+  g_bs->Stall (3000000);      /* 3s: 画面保持 */
+  close_logs ();
+  return EFI_SUCCESS;
+}
