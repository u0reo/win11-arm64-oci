+/* ---- ディレクトリ列挙（bootmgr と同じ Read ループ） ---------------- */
+static void test_dir (FS *fs, const char *tag, CHAR16 *path) {
+  EFI_STATUS       st;
+  EFI_FILE_HANDLE  d = NULL;
+  UINTN            sz, i, nn, cnt = 0;
+  UINT64           h = FNV_INIT;
+  EFI_FILE_INFO   *e;
+
+  UINT64 t0 = now_ms ();
+  say ("--- DIR ");
+  say (fs->win ? "NTFS " : "FAT  ");
+  say (tag);
+  say (" ");
+  say_w (path);
+  say (" ---");
+  nl ();
+  st = fs->root->Open (fs->root, &d, path, EFI_FILE_MODE_READ, 0);
+  say ("  open -> ");
+  say_st ("st", st);
+  nl ();
+  if (EFI_ERROR (st)) return;
+  sz = 512;
+  st = d->GetInfo (d, &gEfiFileInfoGuid, &sz, (VOID *)g_buf);
+  say ("  getinfo -> ");
+  say_st ("st", st);
+  nl ();
+  for (;;) {
+    sz = 4096;
+    st = d->Read (d, &sz, (VOID *)g_buf);
+    if (EFI_ERROR (st)) {
+      say ("  rd-err ");
+      say_st ("st", st);
+      nl ();
+      if (fs->win) g_ntfs_reads_fail++;
+      break;
+    }
+    if (!sz) break;
+    i = 0;
+    while (i + SIZE_OF_EFI_FILE_INFO <= sz) {
+      e = (EFI_FILE_INFO *)(VOID *)(g_buf + i);
+      if (e->Size < SIZE_OF_EFI_FILE_INFO || i + e->Size > sz) {
+        say ("  bad-entry Size=");
+        say_dec (e->Size);
+        say (" rem=");
+        say_dec (sz - i);
+        nl ();
+        if (fs->win) g_ntfs_reads_fail++;
+        break;
+      }
+      nn = (UINTN)(e->Size - SIZE_OF_EFI_FILE_INFO);
+
+      if (i + SIZE_OF_EFI_FILE_INFO + nn > sz) nn = sz - i - SIZE_OF_EFI_FILE_INFO;
+      cnt++;
+      h = fnv (h, (UINT8 *)e->FileName, nn);
+      if (cnt <= 8) {
+        say ("   e=");
+        say_w (e->FileName);
+        say (" size=");
+        say_dec (e->FileSize);
+        say (" attr=");
+        hexval (e->Attribute, 8);
+        nl ();
+      }
+      i += (UINTN)e->Size;
+    }
+    if (cnt > 4000) { say ("  (truncated)"); nl (); break; }
+  }
+  say ("  dir cnt=");
+  say_dec (cnt);
+  say (" nameH=");
+  hex64 (h);
+  nl ();
+  say ("  dir-ms=");
+  say_dec (now_ms () - t0);
+  nl ();
+  d->Close (d);
+}
