+static void shape_read (EFI_FILE_HANDLE f, const char *tag, UINT64 off,
+                        UINTN len, UINT8 *buf) {
+  EFI_STATUS st;
+  UINTN      got = len;
+
+  st = f->SetPosition (f, off);
+  if (EFI_ERROR (st)) {
+    say ("  "); say (tag); say (" off="); hexval (off, 8);
+    say (" seek -> "); say_st ("st", st); nl ();
+    g_shape_fail++;
+    return;
+  }
+  st = f->Read (f, &got, buf);
+  say ("  "); say (tag);
+  say (" off="); hexval (off, 8);
+  say (" len="); say_dec (len);
+  say (" buf="); hexval ((UINT64)(UINTN)buf, 16);
+  say (" -> "); say_st ("st", st);
+  say (" got="); say_dec (got);
+  if (!EFI_ERROR (st) && got) { say (" b="); print_head (buf, got); }
+  nl ();
+  if (EFI_ERROR (st) || got != len) g_shape_fail++;
+}
