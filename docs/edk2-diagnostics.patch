+#define NEWCAP  (32u * 1024u * 1024u)
+
+static void new_test (FS *fs)
+{
+  EFI_STATUS       st;
+  EFI_FILE_HANDLE  h = NULL;
+  UINTN            k, off, got;
+  UINT64           t0, xr, h0, hl, tot, n;
+
+  if (!fs) {
+    return;
+  }
+  say ("--- NEWTEST BEGIN ---");
+  nl ();
+  t0 = now_ms ();
+  for (k = 0; k < (sizeof (g_newtests) / sizeof (g_newtests[0])); k++) {
+    if (g_newtests[k].dir) {
+      test_dir (fs, "new", g_newtests[k].path);
+      continue;
+    }
+    st = fs->root->Open (fs->root, &h, g_newtests[k].path,
+                         EFI_FILE_MODE_READ, 0);
+    if (st == EFI_NOT_FOUND) {
+      say ("  miss #");
+      say_dec (k);
+      say_w (L" ");
+      say_w (g_newtests[k].path);
+      nl ();
+      g_ntfs_miss++;
+      continue;
+    }
+    if (EFI_ERROR (st)) {
+      say ("  FERR #");
+      say_dec (k);
+      say (" ");
+      say_st ("st", st);
+      nl ();
+      g_ntfs_new_fail++;
+      continue;
+    }
+    xr = 0; h0 = 0; hl = 0; n = 0; tot = 0;
+    for (off = 0; off < NEWCAP; off += CHUNK * 8u) {
+      st = h->SetPosition (h, off);
+      if (EFI_ERROR (st)) {
+        break;
+      }
+      got = CHUNK;
+      st = h->Read (h, &got, g_buf);
+      if (EFI_ERROR (st)) {
+        say ("  RDERR #");
+        say_dec (k);
+        say (" off=");
+        hexval (off, 8);
+        say (" ");
+        say_st ("st", st);
+        nl ();
+        g_ntfs_new_fail++;
+        break;
+      }
+      if (got == 0) {
+        break;
+      }
+      {
+        UINT64  c = fnv (FNV_INIT, g_buf, got);
+
+        if (n == 0) {
+          h0 = c;
+        }
+        hl = c;
+        xr ^= c;
+      }
+      tot += got;
+      n++;
+      if (got < CHUNK) {
+        break;
+      }
+    }
+    h->Close (h);
+    h = NULL;
+    say ("  F#");
+    say_dec (k);
+    say_w (L" ");
+    say_w (g_newtests[k].path);
+    say (" n=");
+    say_dec (n);
+    say (" bytes=");
+    say_dec (tot);
+    say (" xor=");
+    hex64 (xr);
+    say (" h0=");
+    hex64 (h0);
+    say (" hl=");
+    hex64 (hl);
+    say (" ms=");
+    say_dec (now_ms () - t0);
+    nl ();
+  }
+  say ("--- NEWTEST END fail=");
+  say_dec (g_ntfs_new_fail);
+  say (" miss=");
+  say_dec (g_ntfs_miss);
+  say (" ms=");
+  say_dec (now_ms () - t0);
+  nl ();
+}
