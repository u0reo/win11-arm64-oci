+  say (" len="); say_dec (bufsz);
+  say (" open="); say_st ("st", st);
+  if (EFI_ERROR (st)) { nl (); return; }
+  st = g_bs->AllocatePool (EfiLoaderData, bufsz, (VOID **)&buf);
+  if (EFI_ERROR (st) || buf == NULL) {
+    say (" pool="); say_st ("st", st); nl ();
