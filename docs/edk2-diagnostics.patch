+/* EDK2 port of work/diag/rdchk.c (gnu-efi recipe is unusable on AARCH64). */
+#include <Uefi.h>
+#include <Library/UefiApplicationEntryPoint.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiLib.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Library/TimerLib.h>
+#include <Library/DevicePathLib.h>
+#include <Protocol/SerialIo.h>
+#include <Protocol/SimpleFileSystem.h>
+#include <Guid/FileInfo.h>
+#include <Guid/FileSystemInfo.h>
+
+/*
+ * rdchk.c - NTFS SimpleFileSystem の「読み出し」経路を徹底検証する EFI アプリ
+ *
+ * 背景: v5 で fs2(NTFS) に対する if exist / echo > file は成功したが、
+ *       load winload.efi は "not an image"。ただし winload.efi は
+ *       Subsystem=16 なので EDK2 LoadImage がそもそも弾く（= read の証拠にならない）。
+ *       そこで「同一ファイルを FAT と NTFS の両方から読む」対照実験を行い、
+ *       offset/サイズ別の Read 成否・取得バイト数・FNV ハッシュ・LoadImage
+ *       の正確な EFI_STATUS をコンソールとログファイルに出す。
+ *
+ * 出力先: ConOut / SerialIo / \<FS root>\rdchk.log (FS 全て)
+ */
+
+#define TAG        "RDCHK6"
+#define BIGBUF     (4u * 1024u * 1024u)
+#define CHUNK      65536u
+#define FNV_PRIME  0x00000100000001B3ULL
+#define FNV_INIT   0xCBF29CE484222325ULL
+
+static EFI_HANDLE                    g_image;
+static EFI_SYSTEM_TABLE             *g_st;
+static EFI_BOOT_SERVICES            *g_bs;
+static EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *g_conout;
+static EFI_SIMPLE_TEXT_OUTPUT_PROTOCOL *g_serout;
+static EFI_FILE_HANDLE               g_logA = NULL;
+static EFI_FILE_HANDLE               g_logB = NULL;
+static UINT8                        *g_buf;          /* BIGBUF 読み捨て */
+static UINT64                        g_ntfs_reads_fail;
+static UINT64                        g_ntfs_bytes_read;
+static UINT64                        g_ntfs_seek_rej;
+static UINT64                        g_ntfs_new_fail;
+static UINT64                        g_ntfs_eofshort;
+
+/* ---- 出力 helpers (diag.c と同じ思想) --------------------------------- */
+static void log_raw (const char *s) {
+  UINTN n;
+  if (g_logA) {
+    n = 0; while (s[n]) n++;
+    if (EFI_ERROR (g_logA->Write (g_logA, &n, (VOID *)s))) g_logA = NULL;
+  }
+  if (g_logB) {
+    n = 0; while (s[n]) n++;
+    if (EFI_ERROR (g_logB->Write (g_logB, &n, (VOID *)s))) g_logB = NULL;
+  }
+}
+
+static void say (const char *s) {
+  CHAR16 b[512];
+  int i = 0;
+  log_raw (s);
+  for (; s[i] && i < 511; i++) b[i] = (CHAR16)(UINT8)s[i];
+  b[i] = 0;
+  if (g_conout && g_conout->OutputString) g_conout->OutputString (g_conout, b);
+  if (g_serout && g_serout->OutputString) g_serout->OutputString (g_serout, b);
+}
+
+static void nl (void) { say ("\n"); }
+
+static void say_w (CHAR16 *w) {
+  char  b[64];
+  int   i = 0;
+  if (!w) { say ("(null)"); return; }
+  for (; i < 62 && w[i]; i++) b[i] = (char)(CHAR8)(w[i] & 0x7F);
+  b[i] = 0;
+  say (b);
+}
+
+static void hexval (UINT64 v, int digits) {
+  static const char H[] = "0123456789ABCDEF";
+  char b[20];
+  int i;
+  b[0] = '0'; b[1] = 'x';
+  for (i = 0; i < digits; i++) b[2 + i] = H[(v >> ((digits - 1 - i) * 4)) & 0xF];
+  b[2 + digits] = 0;
+  say (b);
+}
+
+static void hex64 (UINT64 v) { hexval (v, 16); }
+
+static void say_dec (UINT64 v) {
+  char t[24];
+  int i = 0, j;
+  if (!v) { say ("0"); return; }
+  while (v && i < 23) { t[i++] = (char)('0' + (v % 10)); v /= 10; }
+  for (j = 0; j < i / 2; j++) { char c = t[j]; t[j] = t[i-1-j]; t[i-1-j] = c; }
+  t[i] = 0;
+  say (t);
+}
+
+static UINT64 now_ms (void)
+{
+  UINT64  f = GetPerformanceCounterProperties (NULL, NULL);
+
+  if (!f) {
+    f = 1000000ULL;
+  }
+  return GetPerformanceCounter () * 1000ULL / f;
+}
+
+static const char *st_name (EFI_STATUS st) {
+  if (st == EFI_SUCCESS)           return "OK";
+  if (st == 0x8000000000000002ULL) return "NOTFOUND";
+  if (st == 0x8000000000000003ULL) return "INVALARG";
+  if (st == 0x800000000000000AULL) return "UNSUP";
+  if (st == 0x8000000000000007ULL) return "DEVERR";
+  if (st == 0x800000000000000BULL) return "BADBUF";
+  if (st == 0x8000000000000009ULL) return "NOBUFFER";
+  if (st == 0x8000000000000004ULL) return "NOMAP";
+  if (st == 0x8000000000000005ULL) return "TIMEOUT";
+  if (st == 0x800000000000000EULL) return "DENIED";
+  if (st == 0x8000000000000017ULL) return "TOOSMALL";
+  if (st == 0x800000000000000DULL) return "NOPERM";
+  if (st == 0x800000000000001BULL) return "WPROT";
+  return "ERR";
+}
+
+static void say_st (const char *label, EFI_STATUS st) {
+  if (label && *label) { say (" "); say (label); say ("="); }
+  if (st == EFI_SUCCESS) { say ("OK"); return; }
+  say (st_name (st));
+  say (":");
+  hexval ((UINT64)st, 16);
+}
+
+/* ---- FS 探索 ---------------------------------------------------------- */
+typedef struct {
+  EFI_HANDLE               h;
+  EFI_FILE_IO_INTERFACE   *fio;
+  EFI_FILE_HANDLE          root;
+  int                      esp;   /* \EFI\Microsoft\Boot\BCD が開ける */
+  int                      win;   /* \V5A.TXT が開ける (NTFS 音量) */
+} FS;
+
+static FS g_fs[8];
+static int g_nfs;
+
+static int fs_open (FS *f, CHAR16 *path, EFI_FILE_HANDLE *out) {
+  EFI_STATUS st;
+  if (!f->root) return 0;
+  st = f->root->Open (f->root, out, path, EFI_FILE_MODE_READ, 0);
+  if (EFI_ERROR (st)) { *out = NULL; return 0; }
+  return 1;
+}
+
+static void enum_fs (void) {
+  EFI_STATUS  st;
+  EFI_HANDLE *hb = NULL;
+  UINTN       n = 0, i;
+
+  st = g_bs->LocateHandleBuffer (ByProtocol,
+                                &gEfiSimpleFileSystemProtocolGuid,
+                                NULL, &n, &hb);
+  say ("[fs] LocateHandleBuffer -> ");
+  say_st ("st", st);
+  say (" n=");
+  say_dec (n);
+  nl ();
+  if (EFI_ERROR (st)) return;
+  for (i = 0; i < n && g_nfs < 8; i++) {
+    FS            *f = &g_fs[g_nfs];
+    EFI_FILE_HANDLE  t = NULL;
+    EFI_FILE_SYSTEM_INFO *si;
+    UINTN           sz = 512;
+
+    f->h = hb[i];
+    f->root = NULL;
+    f->esp = f->win = 0;
+    st = g_bs->HandleProtocol (hb[i], &gEfiSimpleFileSystemProtocolGuid,
+                              (VOID **)&f->fio);
+    if (EFI_ERROR (st) || !f->fio) continue;
+    st = f->fio->OpenVolume (f->fio, &f->root);
+    if (EFI_ERROR (st)) { f->root = NULL; continue; }
+    g_nfs++;
+
+    say ("[fs] #");
+    say_dec (g_nfs - 1);
+    say ("h=");
+    hexval ((UINT64)(UINTN)hb[i], 8);
+    si = (EFI_FILE_SYSTEM_INFO *)(g_buf);
+    if (!f->root->GetInfo (f->root, &gEfiFileSystemInfoGuid, &sz, si)) {
+      say (" ro=");
+      say_dec (si->ReadOnly);
+      say (" bs=");
+      say_dec (si->BlockSize);
+      say (" size=");
+      say_dec (si->VolumeSize);
+      say (" free=");
+      say_dec (si->FreeSpace);
+      say (" lbl=");
+      {
+        char lb[40];
+        int k;
+        for (k = 0; k < 20 && si->VolumeLabel[k]; k++)
+          lb[k] = (char)si->VolumeLabel[k];
+        if (!k) { lb[0] = '-'; k = 1; }
+        lb[k] = 0;
+        say (lb);
+      }
+    }
+    nl ();
+    if (fs_open (f, L"\\EFI\\Microsoft\\Boot\\BCD", &t)) {
+      f->esp = 1;
+      t->Close (t);
+      say ("      ESP-OK (BCD)\n");
+    }
+    if (fs_open (f, L"\\V5A.TXT", &t)) {
+      f->win = 1;
+      t->Close (t);
+      say ("      WIN-OK (V5A.TXT)\n");
+    }
+  }
+  g_bs->FreePool (hb);
+  say ("[fs] found ");
+  say_dec (g_nfs);
+  say (" file systems\n");
+}
+
+static FS *find_fs (int esp) {
+  int i;
+  for (i = 0; i < g_nfs; i++)
+    if (esp ? g_fs[i].esp : g_fs[i].win) return &g_fs[i];
+  return NULL;
+}
+
+/* ---- ハッシュ ---------------------------------------------------------- */
+static UINT64 fnv (UINT64 h, UINT8 *p, UINTN n) {
+  UINTN i;
+  for (i = 0; i < n; i++) { h ^= p[i]; h *= FNV_PRIME; }
+  return h;
+}
+
+static void print_head (UINT8 *p, UINTN n) {
+  UINTN i;
+  if (n > 16) n = 16;
+  for (i = 0; i < n; i++) hexval (p[i], 2);
+}
+
+/* ---- 1 ファイル読取テスト --------------------------------------------- */
+static void test_file (FS *fs, const char *tag, CHAR16 *path,
+                       UINT64 expect_size) {
+  EFI_STATUS      st;
+  EFI_FILE_HANDLE f = NULL;
+  EFI_FILE_INFO  *fi;
+  UINTN           sz;
+  UINT64          fsize, h;
+  UINTN           got;
+  int             iswin = fs->win;
+
+  UINT64 t0 = now_ms ();
+  say ("--- ");
+  say (iswin ? "NTFS " : "FAT  ");
+  say (tag);
+  say (" ---\n");
+
+  st = fs->root->Open (fs->root, &f, path, EFI_FILE_MODE_READ, 0);
+  say ("  open -> ");
+  say_st ("st", st);
+  if (EFI_ERROR (st)) { nl (); return; }
+
+  sz = 512;
+  fi = (EFI_FILE_INFO *)g_buf;
+  st = f->GetInfo (f, &gEfiFileInfoGuid, &sz, fi);
+  say ("  getinfo -> ");
+  say_st ("st", st);
+  nl ();
+  if (st == EFI_BUFFER_TOO_SMALL) {
+    sz = 512;
+    st = f->GetInfo (f, &gEfiFileInfoGuid, &sz, fi);
+    say ("  getinfo2 -> ");
+    say_st ("st", st);
+    nl ();
+  }
+  fsize = 0;
+  if (!EFI_ERROR (st)) {
+    fsize = fi->FileSize;
+    say ("  FileSize=");
+    say_dec (fi->FileSize);
+    say (" Phys=");
+    say_dec (fi->PhysicalSize);
+    say (" Attr=");
+    hexval (fi->Attribute, 16);
+    say (" expect=");
+    say_dec (expect_size);
+    if (expect_size && fsize != expect_size) say (" <<SIZE-MISMATCH>>");
+    nl ();
+  }
+  if (!fsize) fsize = expect_size;
+
+  /* offset/サイズマトリクス */
+  {
+    UINT64 o[16], l[16];
+    int    np = 0, i;
+    o[np] = 0;        l[np++] = 2;
+    o[np] = 0;        l[np++] = 4;
+    o[np] = 0;        l[np++] = 8;
+    o[np] = 0;        l[np++] = 16;
+    o[np] = 0;        l[np++] = 64;
+    o[np] = 0;        l[np++] = 256;
+    o[np] = 0;        l[np++] = 4096;
+    o[np] = 0;        l[np++] = CHUNK;
+    o[np] = 1;        l[np++] = 16;
+    o[np] = 511;      l[np++] = 16;
+    o[np] = 512;      l[np++] = 16;
+    o[np] = 513;      l[np++] = 16;
+    o[np] = 4095;     l[np++] = 2;
+    o[np] = fsize - 16 > 16 ? fsize - 16 : 0;  l[np++] = 16;
+    o[np] = fsize - 1;  l[np++] = 1;
+    o[np] = fsize;      l[np++] = 64;
+    for (i = 0; i < np; i++) {
+      UINTN want2 = (UINTN)l[i];
+      st = f->SetPosition (f, o[i]);
+      if (EFI_ERROR (st)) {
+        say ("  seek off=");
+        hexval (o[i], 8);
+        say (" -> ");
+        say_st ("st", st);
+        nl ();
+        if (iswin && o[i] < fsize) g_ntfs_reads_fail++;
+        else if (iswin) g_ntfs_seek_rej++;
+        continue;
+      }
+      got = want2;
+      st = f->Read (f, &got, g_buf);
+      say ("  rd off=");
+      hexval (o[i], 8);
+      say (" len=");
+      say_dec (want2);
+      say (" -> ");
+      say_st ("st", st);
+      say (" got=");
+      say_dec (got);
+      if (!EFI_ERROR (st) && got) {
+        say (" h=");
+        hex64 (fnv (FNV_INIT, g_buf, got));
+        say (" b=");
+        print_head (g_buf, got);
+      }
+      nl ();
+      if (iswin && EFI_ERROR (st) && o[i] < fsize) g_ntfs_reads_fail++;
+      else if (iswin && o[i] + want2 <= fsize && got != want2) g_ntfs_reads_fail++;
+      else if (iswin && got != want2) g_ntfs_eofshort++;
+      if (iswin) g_ntfs_bytes_read += got;
+    }
+  }
+
+  /* 逐次ストリーム読取 (64KiB chunk) */
+  if (fsize && fsize < BIGBUF) {
+    UINT64 total = 0;
+    h = FNV_INIT;
+    f->SetPosition (f, 0);
+    st = EFI_SUCCESS;
+    while (total < fsize) {
+      got = (UINTN)(fsize - total);
+      if (got > CHUNK) got = CHUNK;
+      st = f->Read (f, &got, g_buf);
+      if (EFI_ERROR (st)) break;
+      if (!got) { say ("  seq short-read got=0 @"); say_dec (total); nl (); break; }
+      h = fnv (h, g_buf, got);
+      total += got;
+    }
+    say ("  seq64k st=");
+    say_st ("st", st);
+    say (" total=");
+    say_dec (total);
+    say (" h=");
+    hex64 (h);
+    nl ();
+    if (iswin) { g_ntfs_bytes_read += total;
+      if (EFI_ERROR (st) || total != fsize) g_ntfs_reads_fail++; }
+  }
+
+  /* 一発読み (LoadImage と同じ挙動) */
+  if (fsize && fsize < BIGBUF) {
+    got = (UINTN)fsize;
+    f->SetPosition (f, 0);
+    st = f->Read (f, &got, g_buf);
+    say ("  one big st=");
+    say_st ("st", st);
+    say (" got=");
+    say_dec (got);
+    say (" h=");
+    if (!EFI_ERROR (st)) hex64 (fnv (FNV_INIT, g_buf, got));
+    nl ();
+    if (iswin && (EFI_ERROR (st) || got != fsize)) g_ntfs_reads_fail++;
+  }
+
+  say ("  ms=");
+  say_dec (now_ms () - t0);
+  nl ();
+  f->Close (f);
+  (void)st;
+}
