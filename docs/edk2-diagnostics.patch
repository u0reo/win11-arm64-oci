+/* ---- ログファイル開放 ----------------------------------------------- */
+static void open_logs (void) {
+  EFI_STATUS  st;
+  EFI_HANDLE *hb = NULL;
+  UINTN       n = 0, i, k = 0;
+  CHAR16      nm[] = L"\\rdchk.log";
+
+  st = g_bs->LocateHandleBuffer (ByProtocol,
+                                &gEfiSimpleFileSystemProtocolGuid,
+                                NULL, &n, &hb);
+  say ("[OL n]");
+  if (EFI_ERROR (st)) return;
+  say_dec (n);
+  for (i = 0; i < n && k < 2; i++) {
+    EFI_FILE_IO_INTERFACE *fio = NULL;
+    EFI_FILE_HANDLE        root = NULL, del = NULL, logf = NULL;
+
+    if (EFI_ERROR (g_bs->HandleProtocol (hb[i],
+            &gEfiSimpleFileSystemProtocolGuid, (VOID **)&fio))) continue;
+    say ("[OLh]");
+    if (EFI_ERROR (fio->OpenVolume (fio, &root))) continue;
+    {
+      static CHAR16 fib[260];
+      UINTN         ssz = sizeof (fib);
+      UINTN         ro  = 1;
+      st = root->GetInfo (root, &gEfiFileSystemInfoGuid, &ssz, (VOID *)fib);
+      if (!EFI_ERROR (st)) ro = ((EFI_FILE_SYSTEM_INFO *)fib)->ReadOnly;
+      say ("[OLro]");
+      say_dec (ro);
+      nl ();
+      if (ro) { root->Close (root); continue; }
+    }
+    {
+      EFI_FILE_HANDLE  chk = NULL;
+      static CHAR16    wp[] = L"\\Windows\\System32\\config\\SOFTWARE";
+      if (!root->Open (root, &chk, wp, EFI_FILE_MODE_READ, 0)) {
+        chk->Close (chk);
+        root->Close (root);   /* never write a log onto a Windows volume */
+        continue;
+      }
+    }
+
+
+    /* 既存あれば消す（切り詰め代替） */
+    if (!root->Open (root, &del, nm, EFI_FILE_MODE_READ, 0)) {
+      del->Delete (del);  /* closes handle internally; never Close after */
+    }
+    st = root->Open (root, &logf, nm,
+                     EFI_FILE_MODE_READ | EFI_FILE_MODE_WRITE |
+                     EFI_FILE_MODE_CREATE, 0);
+    if (EFI_ERROR (st)) { root->Close (root); continue; }
+    say ("[OLo]");
+    if (k == 0) g_logA = logf; else g_logB = logf;
+    k++;
+  }
+  g_bs->FreePool (hb);
+}
+
+static void close_logs (void) {
+  if (g_logA) { g_logA->Close (g_logA); g_logA = NULL; }
+  if (g_logB) { g_logB->Close (g_logB); g_logB = NULL; }
+}
