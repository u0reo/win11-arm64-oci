diff --git a/OemPkg/WlTest/WlTest.c b/OemPkg/WlTest/WlTest.c
new file mode 100644
index 0000000..20e0c64
--- /dev/null
+++ b/OemPkg/WlTest/WlTest.c
@@ -0,0 +1,157 @@
+/* Direct BS->LoadImage probe for winload.efi */
+#include <Uefi.h>
+#include <Library/UefiApplicationEntryPoint.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiLib.h>
+#include <Library/BaseLib.h>
+#include <Library/PrintLib.h>
+#include <Library/DebugLib.h>
+#include <Library/MemoryAllocationLib.h>
+#include <Protocol/SimpleFileSystem.h>
+#include <Protocol/LoadedImage.h>
+
+static EFI_FILE_HANDLE  g_log;
+
+static void put (const char *s)
+{
+  UINTN   n;
+  CHAR16  b[300];
+  int     i;
+
+  if (g_log) {
+    n = 0;
+    while (s[n]) {
+      n++;
+    }
+    g_log->Write (g_log, &n, (VOID *)s);
+  }
+  for (i = 0; s[i] != 0 && i < 290; i++) {
+    b[i] = (UINT16)(UINT8)s[i];
+  }
+  b[i] = 0;
+  Print (L"%s", b);
+  DebugPrint (DEBUG_ERROR, "WLT-ECHO: %a\n", s);
+}
+
+static void rep (const char *tag, EFI_STATUS o, EFI_STATUS rd,
+                 EFI_STATUS ld, UINTN sz)
+{
+  char  b[160];
+
+  AsciiSPrint (b, sizeof (b), "WLT %a o=%r rd=%r ld=%r sz=%x\n",
+               tag, o, rd, ld, sz);
+  put (b);
+}
+
+static void tryf (EFI_FILE_HANDLE vol, CHAR16 *p, const char *tag)
+{
+  EFI_FILE_HANDLE     f = NULL;
+  EFI_STATUS          o, rd, ld;
+  UINTN               sz;
+  VOID                *buf;
+  EFI_HANDLE          img;
+  EFI_LOADED_IMAGE    *li;
+
+  rd = EFI_NOT_READY;
+  ld = EFI_NOT_READY;
+  o = vol->Open (vol, &f, p, EFI_FILE_MODE_READ, 0);
+  if (EFI_ERROR (o)) {
+    rep (tag, o, rd, ld, 0);
+    return;
+  }
+  buf = AllocatePool (0x1800000);
+  if (buf == NULL) {
+    f->Close (f);
+    rep (tag, o, rd, ld, 0);
+    return;
+  }
+  sz = 0x1800000;
+  rd = f->Read (f, &sz, buf);
+  f->Close (f);
+  if (!EFI_ERROR (rd)) {
+    li = NULL;
+    gBS->HandleProtocol (gImageHandle,
+                         &gEfiLoadedImageProtocolGuid, (VOID **)&li);
+    img = NULL;
+    if (li != NULL) {
+      ld = gBS->LoadImage (FALSE, gImageHandle, li->FilePath,
+                           buf, sz, &img);
+    } else {
+      ld = EFI_UNSUPPORTED;
+    }
+  }
+  rep (tag, o, rd, ld, sz);
+  FreePool (buf);
+}
+
+static void openlog (EFI_FILE_HANDLE vol)
+{
+  CHAR16          nm[] = L"\\wltest.log";
+  EFI_FILE_HANDLE del = NULL;
+
+  if (g_log != NULL) {
+    return;
+  }
+  if (!vol->Open (vol, &del, nm, EFI_FILE_MODE_READ, 0)) {
+    del->Delete (del);
+  }
+  if (EFI_ERROR (vol->Open (vol, &g_log, nm,
+          EFI_FILE_MODE_READ | EFI_FILE_MODE_WRITE |
+          EFI_FILE_MODE_CREATE, 0))) {
+    g_log = NULL;
+  }
+}
+
+EFI_STATUS
+EFIAPI
+WlTestMain (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_STATUS               st;
+  EFI_HANDLE               *hb;
+  UINTN                    n, i;
+  EFI_FILE_IO_INTERFACE    *fio;
+  EFI_FILE_HANDLE          vol;
+
+  put ("WLT BEGIN 20261026A\n");
+  hb = NULL;
+  n = 0;
+  st = gBS->LocateHandleBuffer (ByProtocol,
+         &gEfiSimpleFileSystemProtocolGuid, NULL, &n, &hb);
+  {
+    char  b[80];
+    AsciiSPrint (b, sizeof (b), "WLT lh=%r n=%d\n", st, (int)n);
+    put (b);
+  }
+  if (EFI_ERROR (st)) {
+    return 0;
+  }
+  for (i = 0; i < n; i++) {
+    char  b[80];
+    fio = NULL;
+    vol = NULL;
+    AsciiSPrint (b, sizeof (b), "WLT fs %d\n", (int)i);
+    put (b);
+    st = gBS->HandleProtocol (hb[i],
+           &gEfiSimpleFileSystemProtocolGuid, (VOID **)&fio);
+    if (EFI_ERROR (st)) {
+      continue;
+    }
+    st = fio->OpenVolume (fio, &vol);
+    if (EFI_ERROR (st)) {
+      continue;
+    }
+    openlog (vol);
+    tryf (vol, L"\\Windows\\System32\\winload.efi", "W");
+    tryf (vol, L"\\EFI\\Microsoft\\Boot\\bootmgfw.efi", "C");
+    vol->Close (vol);
+  }
+  put ("WLT END\n");
+  if (g_log) {
+    g_log->Close (g_log);
+  }
+  gBS->Stall (2000000);
+  return 0;
+}
