$ErrorActionPreference = "Continue"
$Oem = "C:\OEM"
New-Item -ItemType Directory -Force -Path $Oem | Out-Null
$Log = "$Oem\firstlogon.log"
function Log($m) {
    try {
        ((Get-Date -Format "o") + " " + $m) | Out-File -Append -Encoding ascii $Log -ErrorAction Stop
    } catch {
        # Another instance may hold the log open; never abort firstlogon.
    }
}

# Rendered by scripts/render.py from oem/firstlogon.ps1.template.
$User = "{{WIN_USERNAME}}"
$Pw   = "{{WIN_PASSWORD}}"

Log "=== firstlogon start ==="
Log ("whoami=" + (whoami))

# OOBE already created the account; make sure the password and group are
# deterministic.  boot.ps1 is idempotent and the SYSTEM scheduled task will
# also run it.
& net.exe user $User $Pw 2>&1 | Out-File -Append -Encoding ascii $Log
& net.exe user $User /active:yes 2>&1 | Out-File -Append -Encoding ascii $Log
& net.exe localgroup Administrators $User /add 2>&1 | Out-File -Append -Encoding ascii $Log
try {
    Set-LocalUser -Name $User -PasswordNeverExpires $true -ErrorAction Stop
    Log "user-password-never-expires"
} catch { Log ("user-pwd-fail " + $_.Exception.Message) }

& "$Oem\boot.ps1"

# Do not keep an interactive console session logged in after setup.
& reg.exe add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon" /v AutoAdminLogon /t REG_SZ /d 0 /f 2>&1 |
    Out-File -Append -Encoding ascii $Log
"done" | Out-File -Encoding ascii "$Oem\firstlogon.done"
Log "=== firstlogon done ==="
exit 0
