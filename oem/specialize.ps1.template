$ErrorActionPreference = "Continue"
$Oem = "C:\OEM"
New-Item -ItemType Directory -Force -Path $Oem | Out-Null
$Log = "$Oem\specialize.log"
function Log($m) {
    try {
        ((Get-Date -Format "o") + " " + $m) |
            Out-File -Append -Encoding ascii $Log -ErrorAction Stop
    } catch {
        # A second instance may hold the log open; logging must never abort
        # the specialize pass.
    }
}

# Rendered by scripts/render.py from oem/specialize.ps1.template.
$User = "{{WIN_USERNAME}}"
$Pw   = "{{WIN_PASSWORD}}"

Log "=== specialize start ==="
Log ("whoami=" + (whoami))
Log ("hostname=" + $env:COMPUTERNAME)

# Keep a copy of all OEM scripts locally.  The USB stick will not exist on the
# native OCI boot, so nothing may depend on it after this point.
try {
    if ($PSScriptRoot -and ($PSScriptRoot.TrimEnd([char]92) -ne $Oem.TrimEnd([char]92))) {
        Copy-Item -Path "$PSScriptRoot\*" -Destination $Oem -Recurse -Force -ErrorAction Stop
    }
    Log "oem-copy-ok"
} catch {
    Log ("oem-copy-fail " + $_.Exception.Message)
}
if (-not (Test-Path "$Oem\net.cfg")) {
    @"
ip=10.0.0.192
prefix=24
gw=10.0.0.1
dns=169.254.169.254,1.1.1.1
"@ | Out-File -Encoding ascii "$Oem\net.cfg"
}

# Move Windows RE to the dedicated partition created by host_apply.sh.
# Windows setup's own WinRE specialize pass usually installs it on the
# type-2700 partition before this command runs; winre.ps1 verifies that
# and falls back to reagentc when WinRE is still on C:.
if (Test-Path "$Oem\winre-part.txt") {
    & powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$Oem\winre.ps1" 2>&1 |
        Out-File -Append -Encoding ascii $Log
    Log ("winre-script rc=" + $LASTEXITCODE)
} else {
    Log "winre-script-skip (no dedicated partition)"
}

# Built-in Administrator: same credential as the normal account.
& net.exe user Administrator $Pw 2>&1 | Out-File -Append -Encoding ascii $Log
& net.exe user Administrator /active:yes 2>&1 | Out-File -Append -Encoding ascii $Log
Log "administrator-configured"

# RDP: enable.  NLA is off for lab compatibility; do not expose this port
# directly to the internet.
$ts = "HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server"
$rdp = "$ts\WinStations\RDP-Tcp"
Set-ItemProperty -Path $ts -Name fDenyTSConnections -Type DWord -Value 0 -ErrorAction SilentlyContinue
Set-ItemProperty -Path $rdp -Name UserAuthentication -Type DWord -Value 0 -ErrorAction SilentlyContinue
Set-ItemProperty -Path $rdp -Name SecurityLayer -Type DWord -Value 0 -ErrorAction SilentlyContinue
Set-ItemProperty -Path $rdp -Name MinEncryptionLevel -Type DWord -Value 1 -ErrorAction SilentlyContinue
Set-Service -Name TermService -StartupType Automatic -ErrorAction SilentlyContinue
Start-Service TermService -ErrorAction SilentlyContinue
Log "rdp-configured"

# WinRM: automatic, Basic + unencrypted for lab use.
try {
    Set-Service -Name WinRM -StartupType Automatic -ErrorAction Stop
    Start-Service WinRM -ErrorAction Stop
    Log ("winrm-service=" + (Get-Service WinRM).Status)
} catch {
    Log ("winrm-service-fail " + $_.Exception.Message)
}
try {
    Enable-PSRemoting -Force -SkipNetworkProfileCheck -ErrorAction Stop
    Log "psremoting-ok"
} catch {
    Log ("psremoting-fail " + $_.Exception.Message)
}
# The tiny image does not always ship winrm.exe.  The WSMan provider below
# sets the same listener options and is the supported path when winrm.exe is
# absent.
if (Test-Path "$env:SystemRoot\System32\winrm.exe") {
    & winrm.exe set winrm/config/service/auth '@{Basic="true"}' 2>&1 |
        Out-File -Append -Encoding ascii $Log
    & winrm.exe set winrm/config/service '@{AllowUnencrypted="true"}' 2>&1 |
        Out-File -Append -Encoding ascii $Log
} else {
    Log "winrm.exe-absent"
}
try { Set-Item WSMan:\localhost\Service\Auth\Basic -Value $true -Force -ErrorAction Stop } catch { Log ("wsman-basic-fail " + $_.Exception.Message) }
try { Set-Item WSMan:\localhost\Service\AllowUnencrypted -Value $true -Force -ErrorAction Stop } catch { Log ("wsman-unenc-fail " + $_.Exception.Message) }
Log "winrm-configured"

# Lab network: firewall off.  This is convenient and unsafe on a public
# network; the image is intended for a private OCI VCN / VPN.
& netsh.exe advfirewall set allprofiles state off 2>&1 | Out-File -Append -Encoding ascii $Log
& netsh.exe advfirewall firewall add rule name="RDP 3389" dir=in action=allow protocol=TCP localport=3389 2>&1 | Out-File -Append -Encoding ascii $Log
& netsh.exe advfirewall firewall add rule name="WinRM 5985" dir=in action=allow protocol=TCP localport=5985 2>&1 | Out-File -Append -Encoding ascii $Log
try { Get-NetConnectionProfile -ErrorAction Stop | Set-NetConnectionProfile -NetworkCategory Private -ErrorAction SilentlyContinue } catch {}
Log "firewall-configured"

# No hibernation; AC power never sleeps.
& powercfg.exe /h off 2>&1 | Out-File -Append -Encoding ascii $Log
& powercfg.exe /change standby-timeout-ac 0 2>&1 | Out-File -Append -Encoding ascii $Log
# powercfg /h off removes hiberfil.sys but can leave a BootMgr resumeobject
# behind.  BootMgr then stops at "Start boot option" before Windows starts.
# Delete both resume values explicitly; missing values are harmless.
& bcdedit.exe /deletevalue '{bootmgr}' resumeobject 2>&1 | Out-File -Append -Encoding ascii $Log
& bcdedit.exe /deletevalue '{current}' resumeobject 2>&1 | Out-File -Append -Encoding ascii $Log
Log ("hibernation-off resume-rc=" + $LASTEXITCODE)

# The firmware RTC on QEMU and OCI is UTC.  Without this Windows reads it as
# local time and the clock is off by the time-zone offset (9 hours for JST).
& reg.exe add "HKLM\SYSTEM\CurrentControlSet\Control\TimeZoneInformation" /v RealTimeIsUniversal /t REG_DWORD /d 1 /f 2>&1 | Out-File -Append -Encoding ascii $Log
Log ("rtc-utc rc=" + $LASTEXITCODE)

# Serial recovery: ARM64 Windows does not implement EMS/SAC.  On this build
# bcdedit /ems and /emssettings do write BCD elements even though they report
# success, and an explicit EMSPORT:1 (x86 COM1, I/O port 0x3F8) makes
# bootmgr/winload hang silently on OCI's PL011.  Enabling bootems/EmsEnable
# also duplicates every character on the serial console because EMS and ConOut
# share the same UART.  Leave all of it out; repair Windows through RDP/WinRM.
# finish_disk.sh normalises the BCD again after the Windows pass.
#   & bcdedit.exe /ems '{current}' on
#   & bcdedit.exe /emssettings EMSPORT:1 EMSBAUDRATE:115200
#   & bcdedit.exe /set '{bootmgr}' bootems yes
Log "ems-skipped (ARM64 has no EMS/SAC; explicit EMS breaks OCI serial boot)"

# Optional boot menu over serial and VNC (--boot-menu SECONDS).  With Ubuntu
# kept, GRUB is the first loader and gets its own timeout; this BCD menu
# covers Windows-only builds.
$BootMenu = {{BOOT_MENU_TIMEOUT}}
if ($BootMenu -gt 0) {
    & bcdedit.exe /set '{bootmgr}' displaybootmenu yes 2>&1 | Out-File -Append -Encoding ascii $Log
    & bcdedit.exe /set '{bootmgr}' timeout $BootMenu 2>&1 | Out-File -Append -Encoding ascii $Log
    Log ("boot-menu-configured timeout=" + $BootMenu)
} else {
    & bcdedit.exe /set '{bootmgr}' displaybootmenu no 2>&1 | Out-File -Append -Encoding ascii $Log
    Log "boot-menu-off"
}

# Startup fallback task.  The service route used previously was killed by the
# SCM 45-second timeout; a scheduled task plus a detached PowerShell avoids it.
# Some tiny images omit TaskScheduler.dll, so skip the task instead of
# pretending it was created.  firstlogon.ps1 still runs boot.ps1 directly.
if (Test-Path "$env:SystemRoot\System32\TaskScheduler.dll") {
    $tr = "cmd.exe /c C:\OEM\bootstrap.cmd"
    & schtasks.exe /create /tn "OEM Bootstrap" /tr $tr /sc onstart /ru SYSTEM /rl HIGHEST /f 2>&1 |
        Out-File -Append -Encoding ascii $Log
    Log ("startup-task rc=" + $LASTEXITCODE)
} else {
    Log "startup-task-skipped no-task-scheduler"
}

# Start one detached pass now.  It is harmless if OOBE is still running.
try { Start-Process -FilePath "C:\OEM\bootstrap.cmd" -WindowStyle Hidden -ErrorAction Stop } catch { Log ("bootstrap-start-fail " + $_.Exception.Message) }

Log "=== specialize done ==="
exit 0
